
# ============================================================
# Linux Infrastructure Handbook
# Git ignore rules
# ============================================================

# Environment variables
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Credentials and local secrets
secrets/
.secrets/
credentials.json
credentials.local.*
secrets.local.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
id_ed25519_*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ansible
*.retry
.ansible/
.vault_pass
.vault_password
vault-password.txt
.vault-password-file

# Kubernetes local credentials
.kube/
kubeconfig
kubeconfig.local
kubeconfig.local.*

# Cloud provider local configuration
.aws/
.azure/
.gcloud/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs and temporary files
*.log
*.tmp
*.temp

# Vim
*.swp
*.swo
*.swn
*~

# Editors and IDEs
.vscode/
.idea/
.history/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local workspace
.local/
.scratch/
